(ns culture.facts-test
  (:require [kotoba.lang.edn :as edn]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is]]
            [culture.facts :as facts]))

(deftest mda-has-culture-basis
  (let [sb (facts/spec-basis "MDA")]
    (is (= 7 (count sb)))
    (is (= (count sb) (count (set (map :culture/id sb)))))
    (is (every? #(str/starts-with? (:culture/url %) "https://") sb))
    (is (every? #(= "MDA" (:culture/country %)) sb))
    (is (every? #(nil? (:culture/municipality %)) sb))
    (is (every? #(seq (:culture/summary %)) sb))
    (is (every? #(string? (:culture/retrieved-at %)) sb))))

(deftest unknown-jurisdiction-has-no-basis
  (is (nil? (facts/spec-basis "ROU")))
  (is (nil? (facts/spec-basis "zzz"))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["MDA" "ROU"])]
    (is (= 2 (:requested c)))
    (is (= 1 (:covered c)))
    (is (= ["ROU"] (:missing-jurisdictions c)))))

(deftest by-kind-filters
  (is (= 3 (count (facts/by-kind "MDA" :dish))))
  (is (= ["mda.product.moldovan-wine"]
         (mapv :culture/id (facts/by-kind "MDA" :product))))
  (is (empty? (facts/by-kind "MDA" :other)))
  (is (empty? (facts/by-kind "ROU" :dish))))

(deftest tx-file-matches-catalog
  (let [tx (edn/read-string (slurp "data/culture-tx.edn"))
        flat (mapcat val (sort-by key facts/catalog))]
    (is (= (vec flat) (vec tx)))))
